# Renlink 环境变量示例 — 只放占位值，复制为 .env 后自行填写。
# .env 已在 .gitignore 中，永远不要提交真实 cookie 或密钥。

# ---- 前端（构建期注入） ----
VITE_API_BASE=your-cloud-run-service-name

# ---- 对象存储（COS） ----
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-shanghai
COS_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
COS_SECRET_ID=REPLACE_ME
COS_SECRET_KEY=REPLACE_ME
COS_SESSION_TOKEN=
# 动态临时密钥地址，设置后优先于上面的静态密钥
COS_CREDENTIAL_URL=

# ---- 会话池 / 数据库 ----
SESSION_DB_DSN=
SESSION_DB_PATH=./session.db
SESSION_DB_TABLE=session_pool
SESSION_COS_PREFIX=session/
SESSION_POOL_SOURCE=env
RENLINK_COOKIE_ENV_FILE=
RENLINK_SESSION_MAX_AGE_S=86400
RENLINK_SESSION_RELOAD=0
RENLINK_SESSION_LOCAL_POOL=0

# ---- 平台会话（按需填写，切勿提交真实值） ----
DOUYIN_COOKIE=
RENLINK_DOUYIN_USER_AGENT=
XHS_NOTE_UA=

# ---- 出口 / 渲染 ----
EGRESS_PROXY=
ENABLE_OBSCURA=0
PLAYWRIGHT_CDP=
RENLINK_RENDER_WAIT_MS=8000

# ---- 运行调节 ----
PARSE_RATE_LIMIT_PER_MIN=30
RENLINK_DISABLE_CACHE=0
RENLINK_DROP_ARGUS_HEADER=0
RENLINK_DOUYIN_USER_AGENT=
